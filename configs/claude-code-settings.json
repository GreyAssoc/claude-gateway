{
  "permissions": {
    "deny": [
      "Bash(*gog gmail*delete*)",
      "Bash(*gog gmail*trash*)",
      "Bash(*gog gmail*batch delete*)",
      "Bash(*gog gmail*labels delete*)",
      "Bash(*gog gmail*filters delete*)",
      "Bash(*gog gmail*drafts delete*)",
      "Bash(*gog sheets*write*)",
      "Bash(*gog sheets*update*)",
      "Bash(*gog sheets*append*)",
      "Bash(*gog sheets*clear*)",
      "Bash(*gog sheets*delete*)",
      "Bash(*gog sheets*create*)",
      "Bash(*gog drive*delete*)",
      "Bash(*gog drive*trash*)",
      "Bash(*gog drive*move*)"
    ],
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__playwright__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/stop-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/app/hooks/session-summary.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": {
          "tool_name": "Bash"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/isolation-enforcer.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": {
          "tool_name": "Read"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/isolation-enforcer.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": {
          "tool_name": "Write"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/backup-critical.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/app/hooks/isolation-enforcer.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": {
          "tool_name": "Edit"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/isolation-enforcer.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": {
          "tool_name": "Bash"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/retry-detector.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": {
          "tool_name": "Edit"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/anti-pattern-check.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "/app/hooks/compaction-shield.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "/app/hooks/go-compile-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": {
          "tool_name": "Write"
        },
        "hooks": [
          {
            "type": "command",
            "command": "/app/hooks/anti-pattern-check.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "/app/hooks/compaction-shield.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "/app/hooks/go-compile-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    }
  }
}
