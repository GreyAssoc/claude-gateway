# CHANGED 2026-05-09: replaced steipete/gogcli with an in-tree `gog` binary
# built from /workspace/projects/claude-gateway/cmd/gog/. The previous CLI
# stored OAuth tokens in an ephemeral container path that was wiped on
# restart (host mount was read-only). The new binary uses a token JSON file
# on a Docker volume shared with the gateway, with atomic save on refresh.

# ---------- Stage 1: build the gog Go binary ----------
FROM golang:1.25-alpine AS gog-builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gog/ ./cmd/gog/
COPY internal/gworkspace/ ./internal/gworkspace/
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -o /out/gog ./cmd/gog && \
    /out/gog --version

# ---------- Stage 2: sidecar runtime ----------
FROM node:20-slim

# Install system dependencies
# libreoffice-calc: headless formula recalculation for Excel files
# (openpyxl can write cell values but cannot evaluate formulas;
#  awards/notices workflows need formulas recalculated before docs.py)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-pip git ca-certificates curl \
      libreoffice-calc openssh-client rsync cups-client jq && \
    rm -rf /var/lib/apt/lists/*

# Python packages for grey-docs skills (awards, notices, schedule of condition)
# Split into batches to avoid segfault on slim images
RUN pip3 install --no-cache-dir --break-system-packages \
      openpyxl docxtpl python-docx requests pick && \
    pip3 install --no-cache-dir --break-system-packages \
      pymupdf && \
    pip3 install --no-cache-dir --break-system-packages \
      google-generativeai

# Install Claude Code native binary (required by the Agent SDK).
# The SDK needs the native binary, not the npm-installed Node.js wrapper.
# Retry up to 3 times with backoff — the CDN occasionally returns 429.
RUN for i in 1 2 3; do \
      curl -fsSL https://claude.ai/install.sh | bash && break; \
      echo "Attempt $i failed, retrying in ${i}0s..."; sleep "${i}0"; \
    done
ENV PATH="/root/.claude/local/bin:$PATH"

# Log installed Claude Code version (must support Opus 4.6, released Feb 2026)
RUN claude --version || true

# Also keep the npm CLI for backward compatibility with /run-agent endpoint
RUN npm install -g @anthropic-ai/claude-code

# CHANGED 2026-05-09: in-tree gog binary instead of `curl` from steipete/gogcli.
COPY --from=gog-builder /out/gog /usr/local/bin/gog
RUN chmod +x /usr/local/bin/gog && gog --version

# Install Playwright MCP server + Chromium for web browsing
RUN npm install -g @playwright/mcp@latest && \
    npx playwright install --with-deps chromium

# Sidecar app
WORKDIR /app
COPY sidecar/package.json sidecar/package-lock.json* ./
RUN npm install --production
COPY sidecar/index.js .

# Hooks: SessionStart (context injection), PostToolUse (anti-pattern checker,
# retry detector, compaction shield). Scripts + context files + patterns.
COPY hooks/ /app/hooks/
RUN chmod +x /app/hooks/*.sh

# Claude Code settings (tool permissions + hooks)
RUN mkdir -p /root/.config/claude-code
COPY configs/claude-code-settings.json /root/.config/claude-code/settings.json

# OAuth credentials are mounted at runtime via docker-compose.
# We copy them to a writable location at startup so the SDK can
# write session data without needing the mount to be read-write.
# No ANTHROPIC_API_KEY needed — uses subscription OAuth.

EXPOSE 3001

# Copy OAuth creds at startup. Token storage for gog lives on a writable
# volume mounted at /root/.config/gog (docker-compose.yml), shared with the
# gateway container so OAuth refreshes persist across restarts.
# CHANGED 2026-05-09: dropped the gogcli-ro keyring copy step; the new gog
# uses a single token JSON file on a writable volume — no keyring needed.
CMD ["sh", "-c", "\
  mkdir -p /root/.claude && cp -a /root/.claude-ro/. /root/.claude/ && echo 'Claude OAuth creds copied OK' && \
  cp /root/.config/claude-code/settings.json /root/.claude/settings.json && echo 'Claude Code settings applied' && \
  mkdir -p /root/.config/gog && echo 'gog token dir ready' && \
  if [ -d /root/.ssh-ro ]; then mkdir -p /root/.ssh && cp -a /root/.ssh-ro/. /root/.ssh/ && chmod 700 /root/.ssh && chmod 600 /root/.ssh/id_* 2>/dev/null; chmod 644 /root/.ssh/*.pub 2>/dev/null; echo 'SSH keys copied OK'; fi && \
  exec node index.js"]
