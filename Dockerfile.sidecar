FROM node:20-slim

# Install system dependencies
# libreoffice-calc: headless formula recalculation for Excel files
# (openpyxl can write cell values but cannot evaluate formulas;
#  awards/notices workflows need formulas recalculated before docs.py)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-pip git ca-certificates curl \
      libreoffice-calc && \
    rm -rf /var/lib/apt/lists/*

# Python packages for grey-docs skills (awards, notices, schedule of condition)
# Split into batches to avoid segfault on slim images
RUN pip3 install --no-cache-dir --break-system-packages \
      openpyxl docxtpl python-docx requests pick && \
    pip3 install --no-cache-dir --break-system-packages \
      pymupdf && \
    pip3 install --no-cache-dir --break-system-packages \
      google-generativeai

# Install Claude Code native binary (required by the Agent SDK).
# The SDK needs the native binary, not the npm-installed Node.js wrapper.
# Retry up to 3 times with backoff — the CDN occasionally returns 429.
RUN for i in 1 2 3; do \
      curl -fsSL https://claude.ai/install.sh | bash && break; \
      echo "Attempt $i failed, retrying in ${i}0s..."; sleep "${i}0"; \
    done
ENV PATH="/root/.claude/local/bin:$PATH"

# Also keep the npm CLI for backward compatibility with /run-agent endpoint
RUN npm install -g @anthropic-ai/claude-code

# Install gog CLI for Google Workspace (Gmail, Calendar, Drive, Sheets)
RUN curl -fsSL https://github.com/steipete/gogcli/releases/download/v0.11.0/gogcli_0.11.0_linux_amd64.tar.gz \
    | tar -xz -C /usr/local/bin gog && chmod +x /usr/local/bin/gog

# Install Playwright MCP server + Chromium for web browsing
RUN npm install -g @playwright/mcp@latest && \
    npx playwright install --with-deps chromium

# Sidecar app
WORKDIR /app
COPY sidecar/package.json sidecar/package-lock.json* ./
RUN npm install --production
COPY sidecar/index.js .

# Claude Code settings (tool permissions)
RUN mkdir -p /root/.config/claude-code
COPY configs/claude-code-settings.json /root/.config/claude-code/settings.json

# OAuth credentials are mounted at runtime via docker-compose.
# We copy them to a writable location at startup so the SDK can
# write session data without needing the mount to be read-write.
# No ANTHROPIC_API_KEY needed — uses subscription OAuth.

EXPOSE 3001

# Copy OAuth creds and gog config from read-only mounts to writable dirs, then start.
# Settings are copied AFTER OAuth creds to ensure they aren't overwritten.
CMD ["sh", "-c", "\
  mkdir -p /root/.claude && cp -a /root/.claude-ro/. /root/.claude/ && echo 'Claude OAuth creds copied OK' && \
  cp /root/.config/claude-code/settings.json /root/.claude/settings.json && echo 'Claude Code settings applied' && \
  if [ -d /root/.config/gogcli-ro ]; then mkdir -p /root/.config/gogcli && cp -a /root/.config/gogcli-ro/. /root/.config/gogcli/ && echo 'gog config copied OK'; fi && \
  exec node index.js"]
